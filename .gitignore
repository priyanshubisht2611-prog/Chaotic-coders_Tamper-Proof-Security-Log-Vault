# Root .gitignore for Chaotic-coders_Tamper-Proof-Security-Log-Vault

# Dependencies
node_modules/
**/node_modules/

# Production build outputs
dist/
**/dist/
build/
**/build/

# Caches and temporary files
tsconfig.tsbuildinfo
**/tsconfig.tsbuildinfo
.eslintcache
*.log
*.tmp
.pytest_cache/
**/__pycache__/
*.py[cod]
*$py.class

# Blockchain & Hardhat
blockchain/artifacts/
blockchain/cache/
blockchain/typechain/
blockchain/typechain-types/

# Python Virtual Environments
venv/
.venv/
env/
ENV/

# Databases, Binaries & Local State Files
*.db
*.sqlite
*.sqlite3
cloudflared.exe
*.exe
tunnel.log
tunnel_url.txt
logs.txt
audit_log.jsonl
hash_state.json
hash_chain.json
pending_approvals.json
fcm_tokens.json
*.pdf

# Environment and secrets
.env
.env.*
!.env.example
firebase-service-account.json
api_keys.json
*.pem
*.key

# OS & Editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
