# ── Sentinel Vault — Frontend Environment Variables (example) ────────────────
#
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local — it is listed in .gitignore.
#
# Vite exposes only variables prefixed with VITE_ to the browser bundle.

# ── Firebase Web Push (VAPID) Key ─────────────────────────────────────────────
# From: Firebase Console → Project Settings → Cloud Messaging
#       → Web Push certificates → Key pair
VITE_FIREBASE_VAPID_KEY=

# ── Firebase Client Config ────────────────────────────────────────────────────
# From: Firebase Console → Project Settings → General → Your apps → SDK setup
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
